Type: Package
Package: rdkitpyr
Title: Access Chemoinformatics Functionality in R via the RDKit Python API
Version: 0.1.0.9001
Authors@R: c(
    person("Andrey", "Samokhin",
           email = "andrey.s.samokhin@gmail.com",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0003-0223-6087")),
